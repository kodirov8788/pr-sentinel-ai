# 🔥 PR Sentinel AI: Environment Configuration Example

# GitHub (Required)
# Create a Personal Access Token (PAT) with 'repo' and 'notifications' scopes
GITHUB_TOKEN=ghp_your_secret_token_here

# AI Model (Required)
# Use your existing subscription key for OpenAI or Anthropic
OPENAI_API_KEY=sk-proj-your_key_here
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# n8n Node Config (Optional)
# If using self-hosted n8n, put your instance URL here
N8N_INSTANCE_URL=http://localhost:5678

# Notifications (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_CHAT_ID=xxx
